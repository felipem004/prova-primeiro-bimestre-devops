# =============================================================================
# .env.example: MODELO das variáveis de ambiente do ambiente local
# -----------------------------------------------------------------------------
# Este arquivo VAI para o GitHub e serve de documentação: ele mostra QUAIS
# variáveis o projeto precisa, mas NUNCA contém valores reais de senhas.
#
# Como usar:
#   1. Copie este arquivo para um novo arquivo chamado ".env", na raiz do
#      projeto (o mesmo lugar do docker-compose.yml).
#   2. Preencha os valores no ".env". Ele está no .gitignore e, por isso,
#      NUNCA é enviado ao GitHub.
#   3. Suba o ambiente com: docker compose up -d --build
#
# Regras do formato:
#   - Uma variável por linha, no formato NOME=valor, sem espaços ao redor do "=".
#   - Linhas que começam com "#" são comentários.
#   - Se a senha tiver o caractere "$", coloque o valor entre aspas SIMPLES
#     (ex.: DB_PASSWORD='abc$123'). Sem as aspas, o Compose tentaria
#     interpretar "$123" como uma variável.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Estas 3 variáveis são usadas pelos DOIS serviços do docker-compose.yml:
# - pelo "db", para CRIAR o usuário e o banco na primeira inicialização;
# - pela "api", para se CONECTAR a esse banco.

# Nome do usuário do banco.
DB_USER=reservas_app

# Senha do usuário do banco.
# Fica VAZIA de propósito: se alguém copiar este arquivo e esquecer de
# preencher, o Compose para com erro, em vez de subir um banco sem senha.
# Gere uma senha forte e aleatória, por exemplo com:
#     openssl rand -base64 24
DB_PASSWORD=

# Nome do banco de dados.
DB_NAME=reservas

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Porta do SEU COMPUTADOR onde a API vai responder (http://localhost:PORTA).
# Opcional: se for removida, o docker-compose.yml usa 3000. Troque apenas se a
# porta 3000 já estiver ocupada na sua máquina.
API_PORTA=3000
